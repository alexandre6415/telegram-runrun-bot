# ─────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────

# Token do bot gerado pelo @BotFather
TELEGRAM_API_TOKEN=

# IDs do Telegram autorizados a usar o bot (separados por vírgula)
# Para descobrir seu ID: https://t.me/userinfobot
ALLOWED_USER_IDS=

# ─────────────────────────────────────────────
# Runrun.it — Credenciais
# Encontre em: Runrun.it > Integrações e Apps > API e Webhooks
# ─────────────────────────────────────────────

RUNRUN_APP_KEY=
RUNRUN_USER_TOKEN=

# Slug do usuário responsável pelas tarefas
# Ex: joao-silva (visível na URL do perfil do usuário no Runrun.it)
RUNRUN_RESPONSIBLE_ID=

# ─────────────────────────────────────────────
# Runrun.it — Configuração do projeto
# Para encontrar os IDs, acesse a API ou inspecione a URL no Runrun.it
# ─────────────────────────────────────────────

# ID do projeto onde as tarefas serão criadas
RUNRUN_PROJECT_ID=

# ID do quadro (board) onde as tarefas serão criadas
RUNRUN_BOARD_ID=

# ID do tipo de tarefa a ser criado
RUNRUN_TYPE_ID=
