# Token do bot gerado pelo @BotFather no Telegram
TELEGRAM_API_TOKEN=

# Credenciais da API do Runrun.it
# Encontre em: Runrun.it > Integrações e Apps > API e Webhooks
RUNRUN_APP_KEY=
RUNRUN_USER_TOKEN=

# ID do responsável pelas tarefas no Runrun.it (slug do usuário)
RUNRUN_RESPONSIBLE_ID=

# IDs do Telegram autorizados a usar o bot (separados por vírgula)
# Para descobrir seu ID: https://t.me/userinfobot
ALLOWED_USER_IDS=
